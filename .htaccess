# Hostinger LiteSpeed / Apache Web Server Configuration
Options -Indexes
DirectoryIndex index.html index.php client/dist/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do not rewrite if the requested physical file or directory exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Proxy API requests to backend Node server if mod_proxy is enabled
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
  </IfModule>

  # 3. Route all SPA browser routes to index.html
  RewriteRule ^(.*)$ index.html [L]
</IfModule>
